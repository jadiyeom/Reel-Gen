# Copy this file to .env and fill in your keys. .env is gitignored.
# Everything here is optional except the keys for the features you use.

# ── APIs ────────────────────────────────────────────────────────────────────
# OpenAI — script (structured outputs), voiceover (TTS), captions alignment,
# and clip-matching embeddings. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# fal.ai — AI images (Flux) and AI motion clips (Wan). Only needed if you use AI
# visuals. Get one at https://fal.ai/dashboard/keys
FAL_KEY=...

# Pexels — FREE real stock footage for the clip library. https://www.pexels.com/api/
PEXELS_API_KEY=
# Optional second free stock source. https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── Visuals ─────────────────────────────────────────────────────────────────
# Image backend for each scene: "fal" (Flux, needs FAL_KEY) or "local" (SDXL on a
# CUDA GPU, free — needs requirements-gpu.txt + a CUDA build of torch).
IMAGE_BACKEND=fal

# Motion: "none" = free Ken Burns zoom/pan (default, cost-safe);
#         "all"  = animate every scene with the i2v model (best, costs fal credit);
#         "N"    = animate the N most important scenes.
ANIMATE=none

# i2v model + image model (override only if a fal slug changes).
# I2V_MODEL=fal-ai/wan/v2.2-5b/image-to-video
# FAL_FLUX_MODEL=fal-ai/flux/dev

# ── Voice ───────────────────────────────────────────────────────────────────
# TTS voice: ash/sage/onyx/alloy/echo/nova/shimmer/coral/ballad/verse
TTS_VOICE=onyx
# Extra playback speed-up for a punchy delivery (1.0 = none).
SPEECH_TEMPO=1.15

# ── Captions ────────────────────────────────────────────────────────────────
# faster-whisper device ("cuda" or "cpu") and model ("small"/"medium"/"large-v3").
# Auto-falls back to CPU if CUDA libs aren't installed.
WHISPER_DEVICE=cpu
WHISPER_MODEL=small

# ── Content ─────────────────────────────────────────────────────────────────
# Optional niche to focus the scriptwriter (e.g. "personal finance",
# "fitness motivation", "tech explainers"). Leave blank for purely topic-driven.
CONTENT_NICHE=
# Optional scriptwriter preset from prompts/presets/ (filename, without .md).
# Leave blank to use the default writer. See prompts/presets/README.md.
SCRIPT_PROMPT=
# Spoken length target (seconds); a guide for script generation, not a quota.
TARGET_SECONDS=30

# ── Branding (watermark + optional outro) ───────────────────────────────────
# Watermark is ON by default and appears once you drop a square PNG at
# assets/logo/logo.png and/or set a disclaimer below. Set WATERMARK=false to disable.
WATERMARK=true
BRAND_NAME=Your Brand
BRAND_URL=
BRAND_TAGLINE=
BRAND_DISCLAIMER=

# Optional end card stitched onto every video (off by default). When ON, it uses the
# BRAND_* values + assets/logo/logo.png, with a spoken call-to-action.
OUTRO=false
# OUTRO_VO_TEXT=Follow Your Brand.

# Accent colors used by the outro card and the dashboard (hex).
# BRAND_ACCENT=#6366F1
# BRAND_ACCENT_2=#8B5CF6

# ── Optional social publishing ─────────────────────────────────────────────
# Add platform names only after credentials are configured; publishing is public
# on Instagram, Facebook, and X. YouTube visibility is set separately below.
AUTO_PUBLISH_PLATFORMS=
AUTO_PUBLISH_YOUTUBE_PRIVACY=private
YOUTUBE_CLIENT_SECRETS=data/youtube_client_secrets.json
YOUTUBE_PRIVACY_STATUS=private

# Instagram API with Instagram Login (token from Meta Developer Dashboard).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v26.0
# Default no-card mode: temporarily share the MP4 through Google Drive.
INSTAGRAM_UPLOAD_MODE=drive
INSTAGRAM_DRIVE_TOKEN_FILE=data/instagram_drive_oauth_token.json
# Publicly reachable direct MP4 URL template used by Instagram to fetch each reel.
INSTAGRAM_VIDEO_URL_TEMPLATE=
# Optional automatic staging (S3-compatible, e.g. Cloudflare R2). The bucket or
# custom domain must be publicly readable so Instagram can fetch the MP4.
INSTAGRAM_STORAGE_ENDPOINT_URL=
INSTAGRAM_STORAGE_ACCESS_KEY_ID=
INSTAGRAM_STORAGE_SECRET_ACCESS_KEY=
INSTAGRAM_STORAGE_BUCKET=
INSTAGRAM_STORAGE_PUBLIC_BASE_URL=
INSTAGRAM_STORAGE_REGION=auto
INSTAGRAM_STORAGE_PREFIX=instagram-reels

# Facebook Page Reels API (Page ID and Page access token with content permission).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
# For automatic reconnect when the Page token expires, create a Meta app and
# configure this exact redirect URI in Facebook Login settings.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8765/facebook/callback
FACEBOOK_PAGE_TOKEN_FILE=data/facebook_page_token.json

# X API video publishing (X Developer App with OAuth 2.0 user authentication).
X_CLIENT_ID=
# Optional for confidential/web app types; keep private.
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/x/callback
X_TOKEN_FILE=data/x_oauth_token.json
