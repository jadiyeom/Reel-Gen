# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows batch files need CRLF to run reliably.
*.bat text eol=crlf

# Treat binary assets as binary (no line-ending or diff munging).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.db binary
